---
title: "Indice SNED - Los doce patrones aplicados"
---
classDiagram
    direction TB

    class EstrategiaPredictiva {
        <<STRATEGY - puerto>>
        +predecir(observacion)*
    }
    class EstrategiaDesagregada
    class EstrategiaGlobal
    EstrategiaPredictiva <|-- EstrategiaDesagregada
    EstrategiaPredictiva <|-- EstrategiaGlobal

    class DecoradorDeEstrategia {
        <<DECORATOR>>
        -_envuelta: EstrategiaPredictiva
        +describir() dict
    }
    class EstrategiaAuditada {
        -_sumidero: Callable
        +inferencias_emitidas: int
        CTRL-05
    }
    class EstrategiaConCache {
        -_cache: OrderedDict
        +aciertos: int
        +fallos: int
    }
    EstrategiaPredictiva <|-- DecoradorDeEstrategia
    DecoradorDeEstrategia <|-- EstrategiaAuditada
    DecoradorDeEstrategia <|-- EstrategiaConCache
    DecoradorDeEstrategia o-- EstrategiaPredictiva : envuelve

    class FabricaDeEstrategias {
        <<FACTORY METHOD>>
        -_registro: dict
        +registrar(clase)
        +crear(nombre, auditar, cachear)
    }
    FabricaDeEstrategias ..> EstrategiaAuditada : arma la cadena
    FabricaDeEstrategias ..> EstrategiaConCache : arma la cadena

    class RegistroDeModelos {
        <<REGISTRY>>
        +obtener(archivo) ArtefactoDiferido
        +metadatos_factores() dict
        +inventario() list
    }
    class ArtefactoDiferido {
        <<VIRTUAL PROXY>>
        -_real: Any
        +materializado: bool
        +segundos_de_carga: float
        +predict(X)
        +materializar()
    }
    RegistroDeModelos o-- ArtefactoDiferido : entrega sin materializar
    EstrategiaDesagregada ..> ArtefactoDiferido : 6 artefactos

    class ConstructorDeEscenario {
        <<BUILDER>>
        +desde(observacion)$
        +con(variable, valor)
        +incrementar(variable, delta)
        +construir() Escenario
    }
    class Escenario {
        <<objeto de valor inmutable>>
        +variables: dict
        +cambios: dict
    }
    ConstructorDeEscenario ..> Escenario : construye

    class Especificacion~T~ {
        <<SPECIFICATION>>
        +es_satisfecha_por(candidato)*
        +y(otra)
        +o(otra)
        +no() 
    }
    class _Conjuncion
    class _Disyuncion
    class _Negacion
    class ReglaDeAlerta {
        +construir(c) Alerta*
    }
    class TrampaDeSuperacion
    class RiesgoNormativo
    class CaidaIdps
    class FactorAcotadoDominante
    Especificacion <|-- _Conjuncion
    Especificacion <|-- _Disyuncion
    Especificacion <|-- _Negacion
    Especificacion <|-- ReglaDeAlerta
    ReglaDeAlerta <|-- TrampaDeSuperacion
    ReglaDeAlerta <|-- RiesgoNormativo
    ReglaDeAlerta <|-- CaidaIdps
    ReglaDeAlerta <|-- FactorAcotadoDominante
    _Conjuncion o-- Especificacion : compone

    class IngestorDeFuente {
        <<TEMPLATE METHOD>>
        +ejecutar() invariante
        #_leer_archivo()* gancho
    }
    class IngestorExcel
    class IngestorCsv
    IngestorDeFuente <|-- IngestorExcel
    IngestorDeFuente <|-- IngestorCsv

    class RepositorioEstablecimientos {
        <<REPOSITORY - puerto>>
        +obtener(rbd, periodo)*
    }
    class RepositorioParquet {
        <<ADAPTER>>
    }
    class RepositorioPostgres {
        <<ADAPTER>>
    }
    class fabrica_repositorios {
        <<ABSTRACT FACTORY>>
        +ADAPTADORES: dict
        +obtener_repositorio(nombre)
        REPOSITORIO_DATOS
    }
    RepositorioEstablecimientos <|-- RepositorioParquet
    RepositorioEstablecimientos <|-- RepositorioPostgres
    fabrica_repositorios ..> RepositorioParquet : instancia
    fabrica_repositorios ..> RepositorioPostgres : instancia

    class ServicioDePrediccion {
        <<FACADE>>
        +predecir()
        +explicar()
        +simular()
    }
    ServicioDePrediccion o-- EstrategiaPredictiva
    ServicioDePrediccion o-- RepositorioEstablecimientos
    ServicioDePrediccion o-- ReglaDeAlerta
    ServicioDePrediccion ..> ConstructorDeEscenario
