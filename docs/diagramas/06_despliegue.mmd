        REG[("models/registry<br/>210 MB en disco<br/>145 MB cargados por el motor activo")]
        Q3 -->|"conascencia estatica de nombre y tipo<br/>regla de localidad: aceptable por compartir proceso"| Q2
        Q2 -.->|"carga diferida (Virtual Proxy)"| REG
    end

    subgraph U1["UNIDAD DE DESPLIEGUE 1 - Estacion de ingesta (por lotes, bianual)"]
        direction LR
        RAW[("data/raw<br/>134 archivos CSV y XLSX<br/>11 fuentes integradas")]
        Q1["<b>Q1 · q1_ingesta</b><br/>estilo: tuberia y filtros<br/>leer → normalizar → filtrar → particionar → persistir<br/><i>cuanto fisico</i>"]
        PQ[("data/processed<br/>parquet<br/>cuanto de producto de datos")]
        CU[("cuarentena<br/>lo rechazado se conserva")]
        RAW --> Q1
        Q1 --> PQ
        Q1 --> CU
    end

    BD[("<b>SERVIDOR DE BASE DE DATOS</b><br/>PostgreSQL 16<br/>38 tablas en 4 esquemas<br/>aprox. 838.000 filas")]

    NAV -->|HTTPS| Q4
