flowchart TB
    NAV(["Navegador<br/>equipo directivo o sostenedor"])

    subgraph U3["UNIDAD DE DESPLIEGUE 3 - Nodo de estaticos"]
        Q4["<b>Q4 · q4_cliente</b><br/>HTML, JS y CSS compilados<br/><i>cuanto fisico: acoplamiento nulo</i><br/>sin patrones de dominio, por diseno"]
    end

    subgraph U2["UNIDAD DE DESPLIEGUE 2 - Servidor de aplicacion (UN SOLO PROCESO)"]
        direction TB
        Q3["<b>Q3 · q3_servicio</b><br/>estilo: capas cerradas<br/>router → fachada → repositorio<br/>Repository · Facade · Adapter · Specification"]
