# ------------------------------------------------------------------
# indice-sned — plantilla de configuracion. Copiar a .env y completar.
# .env NUNCA se versiona (ver .gitignore).
# ------------------------------------------------------------------

# --- Rutas (relativas a la raiz del repositorio) ---
SNED_DATA_RAW=data/raw
SNED_DATA_INTERIM=data/interim
SNED_DATA_PROCESSED=data/processed
SNED_MODEL_REGISTRY=models/registry
SNED_MODEL_METADATA=models/metadata

# --- Cuanto 3: servicio FastAPI ---
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ENTORNO=desarrollo

# --- Seguridad / RBAC (CTRL-04) ---
# Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiar-esta-clave-antes-de-cualquier-despliegue
JWT_ALGORITMO=HS256
JWT_MINUTOS_EXPIRACION=480

# --- Cuanto 1/2: persistencia PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=indice_sned
POSTGRES_USER=sned
POSTGRES_PASSWORD=cambiar-en-local
DATABASE_URL=postgresql+psycopg://sned:cambiar-en-local@localhost:5432/indice_sned

# --- Motor predictivo ---
# desagregado = 6 modelos por factor + formula oficial (trazable, R2=0.583)
# global      = HistGradientBoosting unico (preciso, R2=0.637)
MOTOR_POR_DEFECTO=desagregado
XAI_MUESTRA_SHAP=500

# --- Cuanto 4: cliente React ---
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Cuarta ventana. Otro puerto porque el asesor es otra unidad de despliegue.
VITE_AGENTE_URL=http://127.0.0.1:8010

# ------------------------------------------------------------------
# Cuanto 5 · Agente asesor de gestion
# ------------------------------------------------------------------
# El agente consulta el servicio por HTTP, como cualquier usuario. Queda
# sometido a CTRL-04: solo ve los RBD de la jurisdiccion de estas credenciales.
AGENTE_BASE_URL=http://127.0.0.1:8000
AGENTE_PREFIJO_API=/api/v1
AGENTE_USUARIO=sostenedor.demo
AGENTE_CLAVE=demo
AGENTE_SEGUNDOS_ESPERA=10

# determinista (sin red ni clave) | anthropic | openai | gemini
AGENTE_PROVEEDOR=determinista
# Vacio = el modelo por defecto del adaptador. Con gemini, el defecto es
# gemini-2.5-flash. Si pone un modelo fuera de la tabla de precios del
# adaptador, el costo se reporta como cero y marcado como no declarado.
AGENTE_MODELO=

# Bucle y cortacircuitos (ADR-006)
AGENTE_MAX_PASOS=3
AGENTE_UMBRAL_FALLOS=3
AGENTE_SEGUNDOS_REPOSO=30

# Guardarrailes. Se apagan solo en pruebas, nunca en operacion.
AGENTE_GUARDARRAIL_CIFRAS=true
AGENTE_GUARDARRAIL_PROMESAS=true

# Credenciales del proveedor. NUNCA se versionan: van en .env, que esta ignorado.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# La clave de Gemini se emite en Google AI Studio. Una suscripcion de
# consumidor a Gemini no habilita la API: son dos productos distintos.
# GEMINI_API_KEY=
